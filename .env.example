DJANGO_SETTINGS_MODULE=pinaks.settings.development
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Berlin
DATABASE_URL=postgresql://pinaks:pinaks@db:5432/pinaks
POSTGRES_DB=pinaks
POSTGRES_USER=pinaks
POSTGRES_PASSWORD=pinaks

# Non-secret lookup key for outgoing email sender configuration.
EMAIL_SENDER_KEY=default

# SMTP configuration; inject credentials as deployment secrets.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
SMTP_FROM_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
